{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "format:check",
      "type": "npm",
      "script": "format:check",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "ts:check",
      "type": "npm",
      "script": "ts:check",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "check:all",
      "dependsOn": ["lint", "format:check", "ts:check"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
