enum EventType {
  EXAM
  TALK
  OTHER
}

model Event {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  type        EventType
  description String?
  startAt     DateTime
  endAt       DateTime
  speaker     String?
  location    String?
  url         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startAt, id])
}
