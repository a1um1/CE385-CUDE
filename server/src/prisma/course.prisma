model Course {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  color            String
  icon             String
  shortDescription String?  @default("") @db.VarChar(255)
  badge            String?  @default("") @db.VarChar(255)
  position         Int
  createdByID      String   @db.Uuid
  createdBy        User     @relation(fields: [createdByID], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  units Unit[]

  @@index([position, id])
}

model Unit {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  position  Int      @default(0)
  courseID  String   @db.Uuid
  course    Course   @relation(fields: [courseID], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseID, position, id])
}

model Lesson {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  position      Int       @default(0)
  unitID        String    @db.Uuid
  unit          Unit      @relation(fields: [unitID], references: [id])
  passThreshold Decimal   @db.Decimal(3, 2) // 0.00 to 1.00 eg 0.75 = 75% pass threshold
  XPgiven       Int
  gemsGiven     Int
  startAt       DateTime?
  endAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  exercises Exercise[]
  sessions  Sessions[]

  prerequisites LessonPrerequisite[] @relation("lesson")

  requiredBy LessonPrerequisite[] @relation("prerequisite")

  @@index([unitID, position, id])
}

model LessonPrerequisite {
  lessonID             String @db.Uuid
  prerequisiteLessonID String @db.Uuid
  lesson               Lesson @relation("lesson", fields: [lessonID], references: [id], onDelete: Cascade)
  prerequisite         Lesson @relation("prerequisite", fields: [prerequisiteLessonID], references: [id], onDelete: Cascade)

  @@id([lessonID, prerequisiteLessonID])
  @@index([prerequisiteLessonID])
}
