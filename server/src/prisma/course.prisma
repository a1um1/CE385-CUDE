model Course {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  color       String
  icon        String
  // No default: every insert must supply a position, which is what keeps the
  // column dense. Reordering shifts a range of rows by +/-1 and writes the
  // target index directly, so a stray insert defaulting to 0 would silently
  // desynchronise position from row index.
  position    Int
  createdByID String   @db.Uuid
  createdBy   User     @relation(fields: [createdByID], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units Unit[]

  @@index([position, id])
}

model Unit {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  position  Int      @default(0)
  courseID  String   @db.Uuid
  course    Course   @relation(fields: [courseID], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseID, position, id])
}

model Lesson {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  position      Int      @default(0)
  unitID        String   @db.Uuid
  unit          Unit     @relation(fields: [unitID], references: [id])
  passThreshold Decimal  @db.Decimal(3, 2) // 0.00 to 1.00 eg 0.75 = 75% pass threshold
  XPgiven       Int
  gemsGiven     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exercises Exercise[]

  sessions Sessions[]

  @@index([unitID, position, id])
}
