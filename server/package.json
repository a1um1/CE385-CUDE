{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "db:migrate": "prisma migrate dev --name auto && prisma generate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "ts:check": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:github": "prisma generate && vitest run --reporter=github-actions --reporter=default"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@judge0/judge0-js": "^0.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/express-api-reference": "^0.10.14",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "p-limit": "^7.3.1",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.11",
    "openapi-typescript": "^7.13.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
