# Garage config — local dev only.
# Copied to garage.toml.local (gitignored via *.local) by scripts/garage-setup.sh,
# which fills in RPC_SECRET_PLACEHOLDER.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "RPC_SECRET_PLACEHOLDER"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.localhost"

# Public read endpoint: http://<bucket>.localhost:3902/<key>
# *.localhost resolves to loopback in browsers (RFC 6761), no DNS needed.
[s3_web]
bind_addr = "[::]:3902"
root_domain = ".localhost"
