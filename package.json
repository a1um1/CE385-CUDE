{
  "name": "ce385-cude",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/a1um1/CE385-CUDE#readme",
  "bugs": {
    "url": "https://github.com/a1um1/CE385-CUDE/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1um1/CE385-CUDE.git"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --w name --names \"client,server\" \"npm run dev --w client\" \"npm run dev --w server\"",
    "lint": "npm run lint --w client && npm run lint --w server",
    "format:check": "npm run format:check --w client && npm run format:check --w server",
    "openapi:generate": "npx openapi-typescript http://localhost:3000/openapi.json --output ./client/src/data/base/openapi.ts",
    "docker:up": "docker-compose -f scripts/docker-compose.yml --env-file scripts/.env.local up -d",
    "storybook": "npm run storybook --w client",
    "ts:check": "npm run ts:check --w client && npm run ts:check --w server"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1"
  }
}
