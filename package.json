{
  "name": "ce385-cude",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/a1um1/CE385-CUDE#readme",
  "bugs": {
    "url": "https://github.com/a1um1/CE385-CUDE/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1um1/CE385-CUDE.git"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --prefix name --names \"client,server\" \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "lint": "npm run lint --prefix client && npm run lint --prefix server",
    "format:check": "npm run format:check --prefix client && npm run format:check --prefix server",
    "openapi:generate": "npx openapi-typescript http://localhost:3000/openapi.json --output ./client/src/data/base/openapi.ts",
    "docker:up": "docker-compose -f scripts/docker-compose.yml --env-file scripts/.env.local up -d",
    "storybook": "npm run storybook --prefix client",
    "ts:check": "npm run ts:check --prefix client && npm run ts:check --prefix server",
    "judge0:up": "DOCKER_DEFAULT_PLATFORM=linux/amd64 docker-compose -f scripts/judge0/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
