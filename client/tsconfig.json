{
  "extends": "../tsconfig.base.json",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.css.d.ts",
    "src/types/router.d.ts",
    "src/routes/(base)/play-grader.tsx"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "#/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  }
}
